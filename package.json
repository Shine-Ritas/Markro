    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "next": "15.5.24",
    "next-auth": "^5.0.0-beta.31",
    "next-logger": "^5.0.2",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
