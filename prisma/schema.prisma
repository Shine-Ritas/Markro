generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js (Prisma adapter) ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  accounts Account[]
  sessions Session[]
  staff               Staff[]
  auditLogs           AuditLog[]           @relation("AuditLogActor")
  ticketTransactions  TicketTransaction[]

  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Multi-tenant core ──────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  staff         Staff[]
  roles         Role[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  events        Event[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           Staff[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Staff {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([deletedAt])
  @@map("staff")
}

enum StaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ─── SaaS billing (no payment gateway) ──────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Int      @default(0) @map("price_monthly")
  maxEvents    Int      @default(5) @map("max_events")
  maxTickets   Int      @default(1000) @map("max_tickets")
  maxStaff     Int      @default(3) @map("max_staff")
  features     Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  endsAt    DateTime?          @map("ends_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELLED
  EXPIRED
}

// ─── Events (Phase 4) ───────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TicketListView {
  GRID
  COMPACT
  SHOWCASE
  TABLE
}

model TicketDesignPreset {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  previewUrl  String?  @map("preview_url")
  theme       Json
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("ticket_design_presets")
}

model Event {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  name                  String
  slug                  String
  description           String?         @db.Text
  bannerUrl             String?         @map("banner_url")
  rules                 String?         @db.Text
  venue                 String?
  startDate             DateTime        @map("start_date")
  endDate               DateTime?       @map("end_date")
  drawScheduledAt       DateTime?       @map("draw_scheduled_at")
  ticketQuantity        Int             @default(0) @map("ticket_quantity")
  winnerCount           Int             @default(1) @map("winner_count")
  ticketDesignId        String?         @map("ticket_design_id") @db.Uuid
  ticketListViewDefault TicketListView  @default(GRID) @map("ticket_list_view_default")
  status                EventStatus     @default(DRAFT)
  publishedAt           DateTime?       @map("published_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketDesign   TicketDesignPreset? @relation(fields: [ticketDesignId], references: [id], onDelete: SetNull)
  ticketTypes    TicketType[]
  pricePeriods   TicketPricePeriod[]
  tickets        Ticket[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([startDate])
  @@index([ticketDesignId])
  @@map("events")
}

// ─── Tickets (Phase 5) ──────────────────────────────────────────────────────

enum TicketStatus {
  AVAILABLE
  SOLD
  VALIDATED
  CANCELLED
}

enum TicketTransactionType {
  GENERATED
  SALE
  VALIDATION
  REFUND
}

model TicketType {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pricePeriods TicketPricePeriod[]
  tickets      Ticket[]

  @@unique([eventId, slug])
  @@index([tenantId, eventId])
  @@map("ticket_types")
}

/// Date-range pricing — no history log; tickets snapshot priceCents at creation.
model TicketPricePeriod {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  ticketTypeId String?   @map("ticket_type_id") @db.Uuid
  label        String?
  priceCents   Int       @map("price_cents")
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt, endsAt])
  @@index([tenantId, eventId])
  @@map("ticket_price_periods")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  ticketTypeId  String?      @map("ticket_type_id") @db.Uuid
  ticketNumber  String       @map("ticket_number")
  priceCents    Int          @map("price_cents")
  status        TicketStatus @default(AVAILABLE)
  qrToken       String       @unique @map("qr_token")
  soldAt        DateTime?    @map("sold_at")
  validatedAt   DateTime?    @map("validated_at")
  lastScannedAt DateTime?    @map("last_scanned_at")
  scanCount     Int          @default(0) @map("scan_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType?         @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  transactions TicketTransaction[]

  @@unique([eventId, ticketNumber])
  @@index([tenantId, eventId, status])
  @@index([eventId, deletedAt])
  @@map("tickets")
}

model TicketTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  ticketId    String                @map("ticket_id") @db.Uuid
  type        TicketTransactionType
  amountCents Int?                  @map("amount_cents")
  note        String?
  actorId     String?               @map("actor_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([tenantId, createdAt])
  @@map("ticket_transactions")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entity     String?
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
