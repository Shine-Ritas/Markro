generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js (Prisma adapter) ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  accounts Account[]
  sessions Session[]
  staff               Staff[]
  auditLogs           AuditLog[]           @relation("AuditLogActor")
  ticketTransactions  TicketTransaction[]
  posSales            PosSale[]
  drawSessions        DrawSession[]
  drawWinners         DrawWinner[]
  customerProfiles    Customer[]
  customerNotes       CustomerNote[]

  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Multi-tenant core ──────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  staff         Staff[]
  roles         Role[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  events        Event[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           Staff[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Staff {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([deletedAt])
  @@map("staff")
}

enum StaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ─── SaaS billing (no payment gateway) ──────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Int      @default(0) @map("price_monthly")
  maxEvents    Int      @default(5) @map("max_events")
  maxTickets   Int      @default(1000) @map("max_tickets")
  maxStaff     Int      @default(3) @map("max_staff")
  features     Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  endsAt    DateTime?          @map("ends_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELLED
  EXPIRED
}

// ─── Events (Phase 4) ───────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum TicketListView {
  GRID
  COMPACT
  SHOWCASE
  TABLE
}

model TicketDesignPreset {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  previewUrl  String?  @map("preview_url")
  theme       Json
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("ticket_design_presets")
}

model Event {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  name                  String
  slug                  String
  description           String?         @db.Text
  bannerUrl             String?         @map("banner_url")
  rules                 String?         @db.Text
  venue                 String?
  startDate             DateTime        @map("start_date")
  endDate               DateTime?       @map("end_date")
  drawScheduledAt       DateTime?       @map("draw_scheduled_at")
  ticketQuantity        Int             @default(0) @map("ticket_quantity")
  winnerCount           Int             @default(1) @map("winner_count")
  drawOrder             DrawOrder       @default(HIGH_TO_LOW) @map("draw_order")
  ticketDesignId        String?         @map("ticket_design_id") @db.Uuid
  ticketListViewDefault TicketListView  @default(GRID) @map("ticket_list_view_default")
  currencyCode          String?         @map("currency_code") @db.Char(3)
  status                EventStatus     @default(DRAFT)
  publishedAt           DateTime?       @map("published_at")
  drawCompletedAt       DateTime?       @map("draw_completed_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketDesign   TicketDesignPreset? @relation(fields: [ticketDesignId], references: [id], onDelete: SetNull)
  ticketTypes    TicketType[]
  pricePeriods   TicketPricePeriod[]
  tickets        Ticket[]
  posSales       PosSale[]
  drawSessions   DrawSession[]
  drawWinners    DrawWinner[]
  eventPrizes    EventPrize[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([startDate])
  @@index([ticketDesignId])
  @@map("events")
}

// ─── Tickets (Phase 5) ──────────────────────────────────────────────────────

enum TicketStatus {
  AVAILABLE
  SOLD
  VALIDATED
  WINNER
  CANCELLED
}

enum TicketTransactionType {
  GENERATED
  SALE
  VALIDATION
  REFUND
}

model TicketType {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pricePeriods TicketPricePeriod[]
  tickets      Ticket[]

  @@unique([eventId, slug])
  @@index([tenantId, eventId])
  @@map("ticket_types")
}

/// Date-range pricing — no history log; tickets snapshot priceCents at creation.
model TicketPricePeriod {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  ticketTypeId String?   @map("ticket_type_id") @db.Uuid
  label        String?
  priceCents   Int       @map("price_cents")
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt, endsAt])
  @@index([tenantId, eventId])
  @@map("ticket_price_periods")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  ticketTypeId  String?      @map("ticket_type_id") @db.Uuid
  ticketNumber  String       @map("ticket_number")
  priceCents    Int          @map("price_cents")
  status        TicketStatus @default(AVAILABLE)
  qrToken       String       @unique @map("qr_token")
  soldAt        DateTime?    @map("sold_at")
  validatedAt   DateTime?    @map("validated_at")
  lastScannedAt DateTime?    @map("last_scanned_at")
  scanCount     Int          @default(0) @map("scan_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType?         @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  transactions TicketTransaction[]
  posSaleLines PosSaleLine[]
  drawWinner   DrawWinner?

  @@unique([eventId, ticketNumber])
  @@index([tenantId, eventId, status])
  @@index([eventId, deletedAt])
  @@map("tickets")
}

model TicketTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  ticketId    String                @map("ticket_id") @db.Uuid
  type        TicketTransactionType
  amountCents Int?                  @map("amount_cents")
  note        String?
  actorId     String?               @map("actor_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([tenantId, createdAt])
  @@map("ticket_transactions")
}

// ─── POS (Phase 6) ─────────────────────────────────────────────────────────

enum PosSaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model PosSale {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  status        PosSaleStatus @default(DRAFT)
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  customerEmail String?       @map("customer_email")
  customerId    String?       @map("customer_id") @db.Uuid
  quantity      Int           @default(1)
  totalCents    Int           @default(0) @map("total_cents")
  receiptNumber String?       @map("receipt_number")
  actorId       String?       @map("actor_id") @db.Uuid
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor    User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines    PosSaleLine[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, eventId])
  @@index([tenantId, completedAt])
  @@index([customerId])
  @@map("pos_sales")
}

model PosSaleLine {
  id         String @id @default(uuid()) @db.Uuid
  posSaleId  String @map("pos_sale_id") @db.Uuid
  ticketId   String @map("ticket_id") @db.Uuid
  priceCents Int    @map("price_cents")

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([posSaleId, ticketId])
  @@index([ticketId])
  @@map("pos_sale_lines")
}

// ─── Prizes (Phase 7 extension) ─────────────────────────────────────────────

model Prize {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?   @db.Text
  imageUrl    String?   @map("image_url")
  valueCents  Int?      @map("value_cents")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  eventPrizes EventPrize[]
  drawWinners DrawWinner[]

  @@index([tenantId, deletedAt])
  @@map("prizes")
}

model EventPrize {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  prizeId  String @map("prize_id") @db.Uuid
  rank     Int

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prize       Prize        @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  drawWinners DrawWinner[]

  @@unique([eventId, rank])
  @@unique([eventId, prizeId])
  @@index([tenantId, eventId])
  @@map("event_prizes")
}

// ─── Lucky draw (Phase 7) ───────────────────────────────────────────────────

enum DrawOrder {
  HIGH_TO_LOW
  LOW_TO_HIGH
}

enum DrawSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DrawSelectionMethod {
  RANDOM
  MANUAL
}

model DrawSession {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventId       String            @map("event_id") @db.Uuid
  status        DrawSessionStatus @default(PENDING)
  winnerCount   Int               @map("winner_count")
  drawOrder     DrawOrder         @default(HIGH_TO_LOW) @map("draw_order")
  eligibleCount Int               @default(0) @map("eligible_count")
  startedAt     DateTime?         @map("started_at")
  completedAt   DateTime?         @map("completed_at")
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor   User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  winners DrawWinner[]

  @@index([tenantId, eventId])
  @@index([eventId, status])
  @@map("draw_sessions")
}

model DrawWinner {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  drawSessionId   String              @map("draw_session_id") @db.Uuid
  eventId         String              @map("event_id") @db.Uuid
  ticketId        String              @unique @map("ticket_id") @db.Uuid
  rank            Int
  tier            Int?
  selectionMethod DrawSelectionMethod @map("selection_method")
  userId          String?             @map("user_id") @db.Uuid
  customerId      String?             @map("customer_id") @db.Uuid
  buyerName       String?             @map("buyer_name")
  buyerPhone      String?             @map("buyer_phone")
  buyerEmail      String?             @map("buyer_email")
  eventPrizeId    String?             @map("event_prize_id") @db.Uuid
  prizeId         String?             @map("prize_id") @db.Uuid
  prizeName       String?             @map("prize_name")
  selectedAt      DateTime            @default(now()) @map("selected_at")
  actorId         String?             @map("actor_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  drawSession DrawSession @relation(fields: [drawSessionId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventPrize  EventPrize? @relation(fields: [eventPrizeId], references: [id], onDelete: SetNull)
  prize       Prize?      @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  @@unique([drawSessionId, rank])
  @@index([tenantId, eventId])
  @@index([tenantId, selectedAt])
  @@index([customerId])
  @@map("draw_winners")
}

// ─── Customers (Phase 8) ────────────────────────────────────────────────────

enum CustomerSource {
  POS
  MANUAL
  IMPORT
  ONLINE
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  userId           String?        @map("user_id") @db.Uuid
  displayName      String         @map("display_name")
  phone            String
  email            String?
  loyaltyPoints    Int            @default(0) @map("loyalty_points")
  isBlacklisted    Boolean        @default(false) @map("is_blacklisted")
  blacklistReason  String?        @map("blacklist_reason") @db.Text
  referralCode     String         @map("referral_code")
  referredById     String?        @map("referred_by_id") @db.Uuid
  source           CustomerSource @default(MANUAL)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  referredBy        Customer?      @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredCustomers Customer[]     @relation("CustomerReferrals")
  posSales          PosSale[]
  drawWinners       DrawWinner[]
  notes             CustomerNote[]
  referralsSent     Referral[]     @relation("ReferrerCustomer")
  referralsReceived Referral[]     @relation("ReferredCustomer")

  @@unique([tenantId, phone])
  @@unique([tenantId, referralCode])
  @@unique([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isBlacklisted])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([tenantId])
  @@map("customer_notes")
}

model Referral {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  referrerCustomerId  String         @map("referrer_customer_id") @db.Uuid
  referredCustomerId  String?        @map("referred_customer_id") @db.Uuid
  referredPhone       String?        @map("referred_phone")
  eventId             String?        @map("event_id") @db.Uuid
  status              ReferralStatus @default(PENDING)
  rewardPoints        Int            @default(0) @map("reward_points")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  referrerCustomer Customer  @relation("ReferrerCustomer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referredCustomer Customer? @relation("ReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: SetNull)

  @@index([tenantId, referrerCustomerId])
  @@index([tenantId, referredCustomerId])
  @@index([tenantId, referredPhone])
  @@map("referrals")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entity     String?
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
