# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging — trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Google OAuth — set to "true" when AUTH_GOOGLE_ID/SECRET are configured
# Redirect URI in Google Cloud Console (Web client):
#   http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Database
DATABASE_URL=postgresql://luckdraw:luckdraw@localhost:5432/luckdraw?schema=public

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Image storage — switch provider without changing app code
# local = dev disk under public/uploads | s3 = AWS, Cloudflare R2, MinIO, etc.
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=
IMAGE_UPLOAD_MAX_BYTES=5242880

# S3-compatible (when STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PUBLIC_URL=
